# IVORA backend settings.
# Copy this file to backend/.env (same folder) and fill in the values.
# .env is private: never share it, zip it or commit it.

# "simulator" = practice mode with clearly labelled fake data (works with no device)
# "blynk"     = read the real device through Blynk Cloud
DATA_SOURCE=simulator

# Your Blynk device auth token (Blynk app > device > Device Info > Auth Token).
BLYNK_TOKEN=

# Which virtual pin carries the weight. Check it with the "Check Blynk connection" button.
BLYNK_WEIGHT_PIN=V1
# If the Blynk app shows a different server (e.g. blr1.blynk.cloud), put it here.
BLYNK_BASE_URL=https://blynk.cloud
POLL_INTERVAL_S=2

DEVICE_ID=bed1

# Units: grams = raw value x WEIGHT_SCALE + WEIGHT_OFFSET_G.
# Leave UNITS_VERIFIED=false until you have weighed known masses.
WEIGHT_SCALE=1.0
WEIGHT_OFFSET_G=0.0
UNITS_VERIFIED=false
# The bench node uses a 40 kg load cell. With 1000 a full bag would be rejected as invalid.
LOAD_CELL_CAPACITY_G=40000

# Only needed if you run WITHOUT Docker and want PostgreSQL instead of the default SQLite file:
# DATABASE_URL=postgresql://iv:password@localhost:5432/iv_monitor

# Prototype thresholds (validate experimentally before reporting results)
INTERRUPTION_RATE_G_MIN=0.5
INTERRUPTION_PERSIST_S=120
HIGH_RATE_ABS_G_MIN=8
HIGH_RATE_FACTOR=2
HIGH_RATE_PERSIST_S=60
BAG_JUMP_G=50
BAG_STABLE_S=30
LOW_VOLUME_PCT=15
LOW_VOLUME_PERSIST_S=10

# Low-false-alarm settings (prototype defaults, not validated)
# Smallest step the device reports; Blynk V1 was seen in whole grams.
# Keep 1 even if the IVORA firmware sends one decimal: a 40 kg cell is not
# repeatable to 0.1 g, so the extra digit is mostly noise.
WEIGHT_RESOLUTION_G=1
# A rate change must exceed this many standard errors to count.
RATE_SIGMA_K=3
# A threshold crossing shorter than this does not restart a persistence timer.
RULE_GRACE_S=20

# Alarms (prototype defaults, not validated)
# Interruption / high-rate / low-volume alarms only while a bag session is active.
ALARMS_REQUIRE_BAG=true
# Recovery must last this long before an alarm clears.
ALARM_CLEAR_S=30
INTERRUPTION_CLEAR_G_MIN=1.0
HIGH_RATE_CLEAR_FRACTION=0.8
LOW_VOLUME_CLEAR_MARGIN_PCT=5
# Sensor and data-loss problems must last this long to alarm.
ALARM_SENSOR_PERSIST_S=60
# Noise / drift alarms go from LOW (silent) to MEDIUM after this long.
ALARM_ESCALATE_S=600
# The same alarm coming back within this time reopens the old one.
ALARM_REARM_S=300
# An acknowledged HIGH alarm beeps again after this long if still active (0 = never).
ALARM_RESOUND_S=300
